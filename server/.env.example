# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# docker compose up -d → postgres://postgres:postgres@localhost:5432/appdb
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appdb"

# Used by Prisma Accelerate or direct connections (same as DATABASE_URL if no pooler)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/appdb"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Frontend URL allowed to make requests
CORS_ORIGIN="http://localhost:5173"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Strong random secret — generate with: openssl rand -hex 64
JWT_SECRET=""

# Separate secret for refresh tokens — must differ from JWT_SECRET
JWT_REFRESH_SECRET=""

# ─── Password Hashing ────────────────────────────────────────────────────────
# bcrypt salt rounds (10 = recommended minimum, 12 = more secure, slower)
SALT_ROUNDS=10

# ─── Cookies ────────────────────────────────────────────────────────────────
# Optional. Set only if API and client share a parent domain in production.
# Example: .strawby.com
COOKIE_DOMAIN=

# ─── Swagger (API Docs) ──────────────────────────────────────────────────────
# Basic auth credentials for /api-docs route (dev only — Swagger is disabled when NODE_ENV=production)
# Leave empty to disable basic auth. Set BOTH to enable.
# Generate strong password: openssl rand -base64 24
SWAGGER_USER=
SWAGGER_PASSWORD=

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender address (e.g. "Strawby <no-reply@strawby.com>")
EMAIL_FROM=

# ─── Google OAuth ────────────────────────────────────────────────────────────
# OAuth 2.0 Client credentials from https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Firebase Admin (Push Notifications) ─────────────────────────────────────
# Service account from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Full PEM key on one line with literal \n for line breaks, wrapped in quotes
FIREBASE_PRIVATE_KEY=""
