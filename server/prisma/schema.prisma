generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum FoodSource {
  TACO
  USDA_FOUNDATION
  USDA_SR_LEGACY
  CNF
  LIVS
  OFF
  MANUAL
}

enum MealKind {
  DAILY
  PLAN
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum Role {
  patient
  nutritionist
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  role            Role
  termsAcceptedAt DateTime?
  termsVersion    String?
  patient         Patient?
  nutritionist    Nutritionist?
}

model Patient {
  id                 String              @id
  user               User                @relation(fields: [id], references: [id], onDelete: Cascade)
  nutritionistId     String?
  nutritionist       Nutritionist?       @relation(fields: [nutritionistId], references: [id], onDelete: SetNull)
  plans              Plan[]
  meals              Meal[]
  recipes            Recipe[]
  privateFoods       PrivateFood[]
  dailyScores        DailyScore[]
  connectionRequests ConnectionRequest[]
  currentStreak       Int                 @default(0)
  bestStreak         Int                 @default(0)
  weight             Float?
  height             Float?
  age                Int?
  gender             String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Nutritionist {
  id                 String              @id
  user               User                @relation(fields: [id], references: [id], onDelete: Cascade)
  patients           Patient[]
  code               String?             @unique
  connectionRequests ConnectionRequest[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model DailyScore {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  score     Float
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patientId, date])
  @@index([patientId, date])
}

model Plan {
  id        String   @id @default(uuid())
  calories  Float
  protein   Float
  carbs     Float
  fat       Float
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Food {
  id            String         @id @default(uuid())
  name          String
  nameOriginal  String?
  source        FoodSource
  sourceId      String?
  sourceUrl     String?
  category      String?
  priority      Int            @default(0)
  calories      Float
  protein       Float
  carbs         Float
  fat           Float
  fiber         Float?
  sodium        Float?
  servingSize   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  foodItems     FoodItem[]

  @@unique([source, sourceId])
  @@index([priority(sort: Desc), name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model PrivateFood {
  id          String     @id @default(uuid())
  name        String
  calories    Float
  protein     Float
  carbs       Float
  fat         Float
  fiber       Float?
  sodium      Float?
  servingSize String?
  patientId   String
  patient     Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  foodItems   FoodItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([patientId])
}

model Meal {
  id        String     @id @default(uuid())
  name      String
  kind      MealKind   @default(DAILY)
  mealType  String?
  time      String?
  date      DateTime   @default(now())
  patientId String
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items     FoodItem[]
  recipes   Recipe[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([patientId, kind, date])
}

model FoodItem {
  id            String       @id @default(uuid())
  quantity      Float
  calories      Float
  protein       Float
  carbs         Float
  fat           Float
  mealId        String?
  recipeId      String?
  foodId        String?
  privateFoodId String?
  meal          Meal?        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  recipe        Recipe?      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food          Food?        @relation(fields: [foodId], references: [id])
  privateFood   PrivateFood? @relation(fields: [privateFoodId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([mealId])
  @@index([recipeId])
}

model Recipe {
  id        String     @id @default(uuid())
  name      String
  patientId String
  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items     FoodItem[]
  meals     Meal[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([patientId])
}

model ConnectionRequest {
  id             String                  @id @default(uuid())
  status         ConnectionRequestStatus @default(PENDING)
  nutritionistId String
  nutritionist   Nutritionist            @relation(fields: [nutritionistId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt      DateTime                @default(now())

  @@index([nutritionistId])
  @@index([patientId])
}
