{
  "name": "strawby",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "concurrently \"pnpm --filter ./client dev\" \"pnpm --filter ./server start:dev\"",
    "build": "pnpm --filter ./client build && pnpm --filter ./server build",
    "start:prod": "pnpm --filter ./server start:prod",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json}\"",
    "client": "cd client && pnpm run dev",
    "server": "cd server && pnpm run start:dev",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:dev": "docker compose up --build",
    "docker:prod": "docker compose -f docker-compose.yml up --build -d",
    "docker:clean": "docker compose down -v --remove-orphans"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
