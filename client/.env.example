# URL pública do site, sem barra final (ex: https://app.exemplo.com).
# Alimenta canonical, og:url, JSON-LD e o sitemap. Em produção tem que ser o domínio
# real — canonical errado faz o Google tratar o site de verdade como duplicata.
VITE_SITE_URL=

# Backend API base URL
VITE_API_URL=

# Google OAuth 2.0 Client ID (same project as the server's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=

# Firebase Cloud Messaging Web Push certificate key pair (Project Settings → Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=
